<?xml version="1.0" encoding="utf-8"?>
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />       <!-- English -->
    <locale android:name="ru" />       <!-- Russian -->
    <!-- Montenegrin — primary app locale for Montenegro -->
    <locale android:name="cnr-Cyrl-ME" />  <!-- Montenegrin (Cyrillic) -->
    <locale android:name="cnr-Latn-ME" />  <!-- Montenegrin (Latin) -->
    <!-- Serbian aliases kept for compatibility with older captures/devices -->
    <locale android:name="sr-Cyrl" />      <!-- Serbian (Cyrillic) -->
    <locale android:name="sr-Latn" />      <!-- Serbian (Latin) -->
</locale-config>
