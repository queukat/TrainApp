{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trainme-feedback",
  "main": "src/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-18",
  "account_id": "af17df6b447203c4b1459e03da69eaea",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trainme-feedback",
      "database_id": "d8695cad-24f5-497e-b481-fd80ae96345c",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_SUBMIT_RATE_LIMIT",
      "namespace_id": "615247981",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_EXPECTED_HOSTNAME": "trainme-feedback.queukat.workers.dev",
    "TURNSTILE_EXPECTED_ACTION": "feedback"
  }
}
